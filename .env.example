# Copy to .env and fill in. .env is git-ignored.

# Google AI Studio key: https://aistudio.google.com/apikey
#
# The free tier is enough to try this, but not to demo it. A live check sends a frame, so it
# spends far more tokens per request than a text call, and a few rolling checks in a row will
# hit the free per-minute token quota and start returning 429. Enable billing on the key
# before showing it to anyone: https://aistudio.google.com/apikey (Set up billing).
GOOGLE_API_KEY=

# Read as a fallback if GOOGLE_API_KEY is unset. Either name works.
GEMINI_API_KEY=

# Optional. Batch extraction and the ClickHouse agent. Defaults to gemini-3.6-flash, falling
# back a generation if it is overloaded.
DAILIES_MODEL=

# Optional, and deliberately a SEPARATE name from DAILIES_MODEL. The rolling check defaults
# to gemini-3.5-flash because it answers in about a third of the time, and a continuity check
# that lands after the take has ended is worthless. Setting DAILIES_MODEL does not and should
# not change the live path.
DAILIES_LIVE_MODEL=

# Optional. Where processed takes are read from and written to. Defaults to ./out.
DAILIES_OUT=

# ClickHouse Cloud, read from the service's Connect panel.
#
# CLICKHOUSE_DATABASE is `default` unless you deliberately created another one. This file
# said `dailies` for a while, which is a database that does not exist on a new ClickHouse
# Cloud service, so a fresh clone following it failed on the first query.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Vertex AI, which is how the deployed service reaches Gemini.
#
# Set DAILIES_USE_VERTEX=true to authenticate as the Google Cloud service account the code is
# already running as, with no API key anywhere. On Cloud Run that works out of the box. On a
# laptop it needs Application Default Credentials first: gcloud auth application-default login
#
# Leave it unset and the code uses GOOGLE_API_KEY above, which is the right choice for a
# reviewer who wants to run this without a Google Cloud project.
#
# The location is deliberately `global` and was measured, not guessed: us-east1 does not serve
# gemini-3.6-flash at all and us-central1 returns 404 for both 3.5 and 3.6. Only global serves
# all three models this project uses.
DAILIES_USE_VERTEX=
DAILIES_VERTEX_PROJECT=
DAILIES_VERTEX_LOCATION=global

# Read as a fallback for DAILIES_VERTEX_PROJECT. Cloud Run sets it for you.
GOOGLE_CLOUD_PROJECT=
