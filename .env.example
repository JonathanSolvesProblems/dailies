# Copy to .env and fill in. .env is git-ignored.

# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Defaults to gemini-3.6-flash, falling back a generation if it is overloaded.
DAILIES_MODEL=

# ClickHouse Cloud, read from the service's Connect panel.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=dailies
